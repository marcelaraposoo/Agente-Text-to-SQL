# Ordem = prioridade (fallback). Só entram provedores que tiverem chave.
LLM_PROVIDERS=gemini

# Gemini (Google AI Studio): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash

# OpenRouter é opcional. Para usar, coloque o nome na lista acima
# (LLM_PROVIDERS=gemini,openrouter) e preencha a chave abaixo.
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=openrouter/free,nvidia/nemotron-3.5-lightning:free

DB_PATH=cinerocket.db
QUERY_TIMEOUT=60